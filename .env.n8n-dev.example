# The Pitt API against n8n DEV (workflow FRYm3m0UAffFyJLq, W1-W5 added 2026-10-21, unpublished).
# Copy to .env.n8n-dev (git-ignored), fill the four secret lines, then: npm run api:n8n-dev
# Never commit .env.n8n-dev and never paste its values into chat.

PITT_ENV=dev
PORT=8080
PITT_DATA_DIR=.pitt-data

# Sign-in. For a laptop test you may use PITT_ENV=local + PITT_AUTH_MODE=dev instead (one local user, no tokens).
PITT_AUTH_MODE=tokens
# SECRET-DERIVED: [{"id":"you","token_sha256":"<sha256 of your access token>","roles":["viewer","launcher","refresher","approver"],"networks":["*"],"partners":["amazon_dsp"]}]
PITT_USERS_JSON=
# SECRET: 32+ random characters
PITT_SESSION_SECRET=

# n8n dev. W1 path is the-pitt-launch-f95a59df. n8n's Test URL listens only while "Listen for test event" is
# pressed in the editor; the /webhook/ Production URL works only once the workflow is published (it is not).
# Confirm the exact URL in the W1 node before the first launch.
PITT_ALLOWED_OUTBOUND_HOSTS=n8n.eqtv.dev
PITT_N8N_LAUNCH_URL=https://n8n.eqtv.dev/webhook-test/the-pitt-launch-f95a59df
PITT_N8N_LAUNCH_HEADER_NAME=x-pitt-launch-key     # must equal the Name of the Header Auth credential selected on W1
PITT_N8N_LAUNCH_HEADER_VALUE=  # SECRET: same value as that credential
PITT_N8N_WORKFLOW_ID=FRYm3m0UAffFyJLq
# must equal the Name of the Header Auth credential on W5 / W5p
PITT_CALLBACK_HEADER_NAME=x-pitt-callback-key
# SECRET: same value as that credential
PITT_CALLBACK_HEADER_VALUE=
# the project has 25 n8n executions / week in total
PITT_WEEKLY_LAUNCH_BUDGET=5
PITT_MAX_CONCURRENT_RUNS=1

# Keep every external write off.
PITT_MANAGE_WRITES_ENABLED=false
PITT_WRITE_KILL_SWITCH=true
