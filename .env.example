# The Pitt server configuration: variable NAMES only. Put values in the platform's secret manager, never in this file,
# the repository, the browser bundle or chat. Nothing below starts with VITE_, so none of it can reach client code.

# --- Environment
PITT_ENV=                      # local | dev | staging | production (shown in the UI; production is highlighted)
PORT=                          # set by Firebase App Hosting / Cloud Run
PITT_DATA_DIR=                 # file store directory (single instance only; production needs a managed database, see docs)

# --- Sign-in
PITT_AUTH_MODE=                # tokens (default) | dev (refused unless PITT_ENV=local)
PITT_USERS_JSON=               # [{"id":"...","token_sha256":"<hex sha256 of the user's access token>","roles":["viewer","launcher","refresher","approver"],"networks":["*"],"partners":["amazon_dsp"]}]
PITT_SESSION_SECRET=           # 32+ random characters, HMAC key for the session cookie
PITT_SESSION_TTL_MINUTES=

# --- Outbound allowlist (every external call is checked against it)
PITT_PUBLIC_ORIGINS=           # comma-separated browser origins allowed for mutations, e.g. https://thepitt--<project>.<region>.hosted.app
PITT_ALLOWED_OUTBOUND_HOSTS=   # comma-separated host names: the n8n host and <account>.snowflakecomputing.com

# --- n8n launch (main workflow FRYm3m0UAffFyJLq + change set in n8n/)
PITT_N8N_LAUNCH_URL=           # the Webhook node's URL for THIS environment, confirmed with the platform owner (never the editor URL)
PITT_N8N_LAUNCH_HEADER_NAME=   # header name of the n8n "Header Auth" credential on W1
PITT_N8N_LAUNCH_HEADER_VALUE=
PITT_N8N_WORKFLOW_ID=          # recorded on each run for audit
PITT_CALLBACK_HEADER_NAME=     # default x-pitt-callback-key; must match the n8n credential on W5 / W5p
PITT_CALLBACK_HEADER_VALUE=
PITT_WEEKLY_LAUNCH_BUDGET=     # n8n executions this site may use per 7 days (project quota noted in M2 Config: 25 / week, shared)
PITT_MAX_CONCURRENT_RUNS=      # default 1
PITT_N8N_DISPATCH_TIMEOUT_MS=  # default 15000
PITT_RUN_TIMEOUT_MINUTES=      # default 45; a run with no result after this is timed_out
PITT_MAX_RESULT_BYTES=         # default 2000000
PITT_CALLBACK_SKEW_SECONDS=    # default 300

# --- Snowflake (read-only service user, key-pair auth, issued by Analytics)
PITT_SNOWFLAKE_ACCOUNT=        # account identifier used in <account>.snowflakecomputing.com
PITT_SNOWFLAKE_USER=
PITT_SNOWFLAKE_ROLE=
PITT_SNOWFLAKE_WAREHOUSE=
PITT_SNOWFLAKE_PRIVATE_KEY_PEM=
PITT_SNOWFLAKE_PUBLIC_KEY_FP=  # SHA256:... from DESC USER
PITT_SNOWFLAKE_STATEMENT_TIMEOUT_SECONDS=
PITT_SNOWFLAKE_MAX_ROWS=

# --- Manage writes (keep disabled: no verified API yet)
PITT_MANAGE_BASE_URL=
PITT_MANAGE_WRITES_ENABLED=    # false
PITT_WRITE_KILL_SWITCH=        # true (default) = no external write of any kind
PITT_APPROVAL_TTL_MINUTES=     # default 30
